ENVIRONMENT=development
DATABASE_URL=sqlite:///./sentinel.db
TRUSTED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
COOKIE_SECURE=false
DEMO_ENABLED=false
SESSION_HOURS=8
IDLE_MINUTES=30
TIMEZONE=Asia/Bangkok
WORK_START=7
WORK_END=22
# Production: set ALLOWED_HOSTS explicitly to your real hostnames (no testserver),
# HTTPS origins, COOKIE_SECURE=true, ENVIRONMENT=production, DEMO_ENABLED=false
# PostgreSQL example (provide real credentials privately):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/sentinel
